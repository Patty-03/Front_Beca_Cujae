# URL base del backend. Apuntar a la API FastAPI (ej. http://localhost:8000).
VITE_API_URL=http://localhost:8000

# http (por defecto) o demo. El modo demo no debe usarse con datos reales.
VITE_AUTH_MODE=http

# Rol usado únicamente por el adaptador demo. Valores: estudiante, operador, administrador.
VITE_DEMO_ROLE=estudiante
